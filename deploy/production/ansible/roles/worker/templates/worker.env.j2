# Managed by Ansible. Local edits are overwritten on the next deploy.
# ocr-agent worker environment file, exact names from ocr_platform.agent.config.
#
# Root-owned, mode 0600: systemd reads this file as root via EnvironmentFile=
# before dropping privileges to run the service as {{ ocr_service_user }}.

OCR_AGENT_SERVER_ID={{ ocr_worker_server_id }}
OCR_CONTROL_URL={{ ocr_worker_control_url }}
OCR_CONTROL_API_TOKEN={{ ocr_resolved_api_token }}
OCR_AGENT_WORK_DIR={{ ocr_worker_work_dir }}
OCR_AGENT_POLL_INTERVAL={{ ocr_worker_poll_interval }}
OCR_AGENT_HEARTBEAT_INTERVAL={{ ocr_worker_heartbeat_interval }}
OCR_AGENT_CONTROL_RETRY_INITIAL={{ ocr_worker_control_retry_initial }}
OCR_AGENT_CONTROL_RETRY_MAX={{ ocr_worker_control_retry_max }}
OCR_AGENT_EVENT_SPOOL_DIR={{ ocr_worker_spool_dir }}
OCR_AGENT_EVENT_SPOOL_MAX_MB={{ ocr_worker_event_spool_max_mb }}
OCR_AGENT_TERMINATION_TIMEOUT={{ ocr_worker_termination_timeout }}
OCR_AGENT_STOP_POLL_INTERVAL={{ ocr_worker_stop_poll_interval }}
OCR_AGENT_SHARED_ROOTS={{ ocr_worker_shared_roots }}
OCR_AGENT_PYTHON={{ ocr_venv_dir }}/bin/python
OCR_REPO_DIR={{ ocr_source_dir }}
OCR_AGENT_GIT_REF={{ ocr_release_commit }}
OCR_AGENT_SCRIPT_VERSION={{ ocr_release_tag }}
OCR_AGENT_RESOURCE_GUARD_MEMORY_PERCENT={{ ocr_worker_resource_guard_memory_percent }}
