# Managed by Ansible. Local edits are overwritten on the next deploy.
# ocr-platform-control environment file.
#
# Root-owned, mode 0600: systemd reads this file as root via EnvironmentFile=
# before dropping privileges to run the service as {{ ocr_service_user }}.
# Never world- or group-readable: it carries the database URL and the API
# token in plaintext.

# ---- Core settings (exact names from ocr_platform.control.settings) ------
OCR_PLATFORM_DATABASE_URL={{ ocr_resolved_database_url }}
OCR_PLATFORM_REQUIRE_POSTGRES={{ ocr_control_require_postgres }}
OCR_PLATFORM_AUTO_MIGRATE={{ ocr_control_auto_migrate }}
OCR_PLATFORM_REQUIRE_CURRENT_MIGRATIONS={{ ocr_control_require_current_migrations }}
OCR_PLATFORM_HOST={{ ocr_control_listen_host }}
OCR_PLATFORM_PORT={{ ocr_control_listen_port }}
OCR_PLATFORM_API_TOKEN={{ ocr_resolved_api_token }}
OCR_PLATFORM_REQUIRE_API_TOKEN={{ ocr_control_api_auth_required }}
OCR_PLATFORM_ENABLE_REMOTE_ADMIN={{ ocr_control_enable_remote_admin }}
OCR_PLATFORM_ALLOW_SAVED_MODEL_PROFILE_KEYS={{ ocr_control_allow_saved_model_profile_keys }}
{% if not (ocr_control_allow_saved_model_profile_keys | int) %}
# Defense in depth: this flag forces saved profile keys off regardless of the
# ALLOW value above.
OCR_PLATFORM_DISABLE_SAVED_MODEL_PROFILE_KEYS=1
{% endif %}

# ---- Operational tuning (best-effort names, not part of the settings.py
#      contract; unused by the running build if it does not read them) -----
OCR_PLATFORM_JOB_STALE_AFTER_SECONDS={{ ocr_job_stale_after_seconds }}
OCR_PLATFORM_SERVER_STALE_AFTER_SECONDS={{ ocr_server_stale_after_seconds }}
OCR_PLATFORM_SHARD_LEASE_SECONDS={{ ocr_shard_lease_seconds }}
OCR_PLATFORM_SCAN_UNIT_CLAIM_BATCH_SIZE={{ ocr_scan_unit_claim_batch_size }}
OCR_PLATFORM_JOB_FILE_DETAIL_LIMIT={{ ocr_job_file_detail_limit }}
OCR_PLATFORM_JOB_EVENT_DETAIL_LIMIT={{ ocr_job_event_detail_limit }}
OCR_PLATFORM_JOB_LOG_DETAIL_LIMIT={{ ocr_job_log_detail_limit }}
OCR_PLATFORM_JOB_FAILED_FILE_SAMPLE_LIMIT={{ ocr_job_failed_file_sample_limit }}
OCR_PLATFORM_JOB_RECENT_ERROR_SAMPLE_LIMIT={{ ocr_job_recent_error_sample_limit }}
{% if ocr_canary_enabled | default(false) | bool and ocr_canary_model_api_key_env_var | default('', true) | length > 0 %}

# ---- Canary (opt-in): the model API key value, resolved from the
#      controller environment, so Control's own process can reach the
#      already-external model service when a canary job runs. Never logged,
#      never placed in argv, never written to a report.
{{ ocr_canary_model_api_key_env_var }}={{ ocr_resolved_canary_model_api_key }}
{% endif %}
